<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>

    {%- if settings.animations_reveal_on_scroll -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <script>
      window.__APP_CONFIG__ = {
        debug: {{ settings.debug_mode | json }}
      };
    </script>

    {%- liquid
      render 'vite-tag' with 'main.css'
      render 'vite-tag' with 'main.js'
    -%}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet" href="{{ 'component-cart-items.css' | asset_url }}" media="print" onload="this.media='all'">

    {%- if settings.cart_type == 'drawer' -%}
      {{ 'component-cart.css' | asset_url | stylesheet_tag }}
      {{ 'component-totals.css' | asset_url | stylesheet_tag }}
      {{ 'component-price.css' | asset_url | stylesheet_tag }}
      {{ 'component-discounts.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      {{ 'component-localization-form.css' | asset_url | stylesheet_tag: preload: true }}
      <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.predictive_search_enabled -%}
      <link
        rel="stylesheet"
        href="{{ 'component-predictive-search.css' | asset_url }}"
        media="print"
        onload="this.media='all'"
      >
    {%- endif -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>

    {%- comment -%}
      Ici se trouvait une redirection de la page /cart vers l'accueil. Elle faisait du panier un
      cul-de-sac pour tous les chemins qui ne passent pas par le tiroir : les liens de réduction
      en `?redirect=/cart` des campagnes, un panier mis en favori ou partagé, /cart référencé,
      et le repli de l'icône du header sur son `href` si le tiroir ne s'ouvre pas. Le thème a une
      page panier complète (templates/cart.json), elle est de nouveau accessible.

      Le tiroir continue d'intercepter le clic sur l'icône du header (cart-drawer.js), le
      parcours normal est donc inchangé, et la page applique le même consentement CGV que le
      tiroir (snippets/cart-cgv.liquid, rendu dans main-cart-footer.liquid).
    {%- endcomment -%}

    {% assign lang_prefix = '' %}

    {% if request.path contains '/en/' %}
      {% assign lang_prefix = '/en' %}
    {% elsif request.path contains '/it/' %}
      {% assign lang_prefix = '/it' %}
    {% endif %}

    {% assign clean_path = request.path | remove: '/en' | remove: '/it' %}

    {% case clean_path %}
      {% when '/collections/junior' %}
        {% assign value = 'Junior' %}
      {% when '/collections/combi' %}
        {% assign value = 'Combi' %}
      {% when '/collections/flex' %}
        {% assign value = 'Flex' %}
      {% when '/collections/equo' %}
        {% assign value = 'Equo' %}
      {% when '/collections/ecaille' %}
        {% assign value = 'Ecaille' %}
      {% when '/collections/neo-retro' %}
        {% assign value = 'Neo+Retro' %}
    {% endcase %}

    {% if value %}
      <link
        rel="canonical"
        href="{{ shop.url }}{{ lang_prefix }}/collections/optiques?filter.p.m.custom.collections={{ value }}"
      >
      <script>
        window.location.replace('{{ lang_prefix }}/collections/optiques?filter.p.m.custom.collections={{ value }}');
      </script>
    {% endif %}
  </head>

  <body class="{% if template == 'index' %}template-index{% endif %}">
    <div class="u-bg-fixed"></div>

    {% sections 'header-group' %}

    {% render 'debug-grid' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <div class="panel"></div>

    {% sections 'footer-group' %}

    {%- comment -%}
      Tiroir panier : rendu à la racine du body, hors de .section-header (fixed + transform au
      défilement), pour que son z-index de 1000 s'applique réellement au niveau du document.
    {%- endcomment -%}
    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    {%- comment -%}
      Nuanciers des vignettes : chargé globalement, les cartes produit apparaissant dans une
      demi-douzaine de sections et pas seulement dans la grille de collection.
    {%- endcomment -%}
    {%- comment -%}
      Verrou CGV : chargé ici et non dans le tiroir, qui n'est rendu que lorsque le panier est
      en tiroir. La page /cart a son propre bouton de paiement et doit être gardée dans tous
      les cas. Un seul chargement, donc un seul jeu d'écouteurs.
    {%- endcomment -%}
    <script src="{{ 'cart-cgv.js' | asset_url }}" defer="defer"></script>

    {%- comment -%}
      Choix de coloris — point d'entrée, volontairement INLINE.

      Le clic sur une pastille a échoué trop longtemps sur la page collection alors que le même
      code fonctionnait ailleurs, sans que la cause soit observable à distance. On supprime donc
      la dépendance : ces quelques lignes font partie du document, elles ne peuvent ni manquer,
      ni arriver trop tard, ni être servies périmées.

      Elles suffisent à elles seules. Chaque pastille porte sa variante en attributs `data-`
      (snippets/variant-swatches.liquid), ce qui donne le plancher : couper le clic pour que le
      composant de carte du thème ne parte pas vers la fiche, retenir le coloris, et mettre à
      jour la vignette — photo, prix, destination.

      variant-swatches.js, chargé juste après, n'ajoute que le raffinement : table complète des
      variantes, glissement de l'autre option vers une combinaison disponible, marquage des
      ruptures, prévisualisation au survol. S'il ne s'exécute pas, le plancher tient.

      Deux blindages, nés du constat que même un écouteur en capture sur document a échoué en
      production alors qu'il passait tous les bancs de test :

      - Les écouteurs sont sur `window`, premier nœud de la propagation, et le clic est résolu
        par ses COORDONNÉES en plus de sa cible : si un élément étranger au thème (app embed,
        barre d'annonce en panne…) recouvre la grille, `event.target` ne sera jamais la pastille
        et `closest()` ne trouvera rien — mais le point de contact, lui, ne ment pas. On cherche
        alors la pastille sous les coordonnées du geste. Le choix se fait dès `pointerup`, pour
        tenir même si l'évènement `click` n'est jamais délivré.

      - Un panneau de diagnostic embarqué, activé en ajoutant `swatch-debug` à l'URL
        (`?swatch-debug` ou `#swatch-debug`) : thème servi, mode éditeur, nombre de pastilles,
        recouvrement éventuel de la première pastille visible, et trace des derniers gestes.
        Il permet de lire l'état réel de la page sans console — depuis un téléphone aussi.
    {%- endcomment -%}
    <script>
      (function () {
        function swatchAt(target) {
          return target && target.closest ? target.closest('.swatch-picker__swatch') : null;
        }

        function variantOnSwatch(swatch) {
          if (!swatch.dataset.variantId) return null;

          return {
            id: swatch.dataset.variantId,
            o1: null,
            o2: null,
            price: swatch.dataset.variantPrice || '',
            priceShort: swatch.dataset.variantPriceShort || swatch.dataset.variantPrice || '',
            compare: null,
            compareShort: null,
            available: swatch.dataset.variantAvailable !== 'false',
            url: swatch.dataset.variantUrl || '',
            image: swatch.dataset.variantImage || null
          };
        }

        function markRow(swatch) {
          var row = swatch.closest('.swatch-picker__list');
          if (!row) return;

          var buttons = row.querySelectorAll('.swatch-picker__swatch');
          for (var i = 0; i < buttons.length; i++) {
            var selected = buttons[i] === swatch;
            buttons[i].classList.toggle('is-selected', selected);
            if (buttons[i].hasAttribute('aria-pressed')) {
              buttons[i].setAttribute('aria-pressed', selected ? 'true' : 'false');
            }
          }
        }

        {%- comment -%}
          Mise à jour de la vignette produit, faite ici quand card-swatches.js n'a pas pris la
          main. C'est une redite assumée de sa version longue : sans elle, le clic serait bien
          intercepté mais rien ne bougerait à l'écran, ce qui se lit exactement comme une panne.
        {%- endcomment -%}
        function updateCard(swatch, variant) {
          var card = swatch.closest('.product-card');
          if (!card) return;

          var link = card.querySelector('.card__link');
          if (link && variant.url) link.setAttribute('href', variant.url);

          var block = card.querySelector('.price');
          if (block) {
            var short = card.dataset.cardPriceShort === 'true';
            var amount = (short ? variant.priceShort : variant.price) || variant.price;
            var sale = block.querySelector('.price__sale');
            var items = block.querySelectorAll('.price-item--regular, .price-item--sale');
            for (var i = 0; i < items.length; i++) {
              if (sale && sale.contains(items[i]) && items[i].classList.contains('price-item--regular')) continue;
              items[i].textContent = amount;
            }
          }

          var media = card.querySelector('.card__media');
          if (!media || !variant.image) return;

          var preview = media.querySelector('.card__swatch-preview');
          if (!preview) {
            preview = document.createElement('img');
            preview.className = 'card__swatch-preview';
            preview.setAttribute('alt', '');
            preview.setAttribute('aria-hidden', 'true');
            var dots = media.querySelector('.card__dots');
            if (dots) media.insertBefore(preview, dots);
            else media.appendChild(preview);
          }

          if (preview.getAttribute('src') !== variant.image) {
            preview.onload = function () {
              preview.classList.add('is-visible');
            };
            preview.src = variant.image;
          }
          if (preview.complete && preview.naturalWidth > 0) preview.classList.add('is-visible');
        }

        function announce(swatch, variant, name) {
          var host = swatch.closest('variant-swatches') || swatch.closest('.swatch-picker') || swatch;
          host.dispatchEvent(
            new CustomEvent(name, {
              bubbles: true,
              detail: { variant: variant, picker: host, userInitiated: true }
            })
          );
        }

        {%- comment -%}
          Repli par coordonnées : si un calque invisible attrape le geste, event.target n'est
          jamais la pastille et closest() ne trouve rien. On regarde d'abord ce que le document
          voit au point de contact, puis, si ce n'est toujours pas une pastille, on compare le
          point aux rectangles de toutes les pastilles — un calque ne peut pas mentir sur la
          géométrie.
        {%- endcomment -%}
        {%- comment -%}
          Le repli ne doit s'appliquer qu'aux calques INERTES. Un élément cliquable au-dessus
          d'une pastille — bouton d'un popup volontaire, bandeau de consentement, tiroir ouvert —
          a le droit de recevoir son clic : le confisquer casserait une interface légitime. On ne
          passe donc au travers que d'un élément qui n'est ni de l'interface connue du thème, ni
          interactif, ni même désigné comme tel par son curseur.
        {%- endcomment -%}
        function inert(el) {
          if (!el || el === document.documentElement || el === document.body) return true;
          if (!el.closest) return false;
          if (el.closest('cart-drawer, menu-drawer, dialog, [role="dialog"], details[open], .section-header, predictive-search')) {
            return false;
          }
          if (el.closest('a, button, input, select, textarea, label, summary, [onclick], [role="button"]')) {
            return false;
          }
          return window.getComputedStyle(el).cursor !== 'pointer';
        }

        function swatchAtPoint(x, y) {
          if (typeof x !== 'number' || typeof y !== 'number') return null;

          var over = document.elementFromPoint(x, y);
          var direct = swatchAt(over);
          if (direct) return direct;

          {%- comment -%}
            À l'intérieur d'une vignette, les coordonnées priment sans autre condition : tout y
            est cliquable par design (la carte entière navigue, cursor:pointer hérité), et un
            clic au point exact d'une pastille vise la pastille — pas la fiche. Le garde-fou
            d'inertie ne protège que les surcouches extérieures aux vignettes.
          {%- endcomment -%}
          var insideCard = over && over.closest && over.closest('.product-card');
          if (!insideCard && !inert(over)) return null;

          var buttons = document.querySelectorAll('.swatch-picker__swatch');
          for (var i = 0; i < buttons.length; i++) {
            var rect = buttons[i].getBoundingClientRect();
            if (rect.width > 0 && x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom) {
              return buttons[i];
            }
          }
          return null;
        }

        function resolveSwatch(event) {
          return swatchAt(event.target) || swatchAtPoint(event.clientX, event.clientY);
        }

        function choose(swatch) {
          var host = swatch.closest('variant-swatches');
          if (host && typeof host.select === 'function' && typeof host.setup === 'function' && host.setup()) {
            host.select(swatch);
            return;
          }

          var variant = variantOnSwatch(swatch);
          if (!variant) return;

          markRow(swatch);
          announce(swatch, variant, 'variant:selected');
          if (!window.CardSwatchesReady) updateCard(swatch, variant);
        }

        function moved(a, event) {
          var dx = a.x - event.clientX;
          var dy = a.y - event.clientY;
          {%- comment -%}
            12px : sous ce seuil c'est un clic, au-delà c'est le défilement de la rangée. Dans
            ce second cas on ne choisit rien, mais on continue de couper le clic final — un
            glissement qui se termine sur la vignette ne doit pas non plus ouvrir la fiche.
          {%- endcomment -%}
          return dx * dx + dy * dy > 144;
        }

        var press = null;
        var chosenAt = 0;

        window.addEventListener(
          'pointerdown',
          function (event) {
            var swatch = resolveSwatch(event);
            press = swatch ? { swatch: swatch, x: event.clientX, y: event.clientY } : null;
            debugEvent('pointerdown', event, swatch);
          },
          true
        );

        window.addEventListener(
          'pointercancel',
          function () {
            press = null;
          },
          true
        );

        {%- comment -%}
          Le choix se fait dès pointerup : si l'évènement click n'est jamais délivré — quelle
          qu'en soit la raison — le coloris change quand même. Le click qui suit est coupé et
          dédoublonné par chosenAt.
        {%- endcomment -%}
        window.addEventListener(
          'pointerup',
          function (event) {
            var swatch = resolveSwatch(event);
            debugEvent('pointerup', event, swatch);
            if (!swatch || !press || moved(press, event)) return;

            chosenAt = Date.now();
            choose(swatch);
          },
          true
        );

        window.addEventListener(
          'click',
          function (event) {
            var swatch = resolveSwatch(event);
            debugEvent('click', event, swatch);

            var pressed = press;
            press = null;
            if (!swatch && !pressed) return;

            {%- comment -%}
              Coupé dans tous les cas, avant même de savoir si on saura traiter le clic : le
              composant de carte redirige au moindre clic dans la vignette, et choisir un
              coloris ne doit jamais quitter la page.
            {%- endcomment -%}
            event.preventDefault();
            if (event.stopImmediatePropagation) event.stopImmediatePropagation();
            event.stopPropagation();

            if (!swatch) return;
            if (pressed && moved(pressed, event)) return;
            if (Date.now() - chosenAt < 600) return;

            chosenAt = Date.now();
            choose(swatch);
          },
          true
        );

        document.addEventListener('pointerover', function (event) {
          var swatch = swatchAt(event.target);
          if (!swatch) return;

          var host = swatch.closest('variant-swatches');
          if (host && typeof host.peek === 'function' && typeof host.setup === 'function' && host.setup()) {
            host.peek(swatch);
            return;
          }

          var variant = variantOnSwatch(swatch);
          if (!variant) return;

          announce(swatch, variant, 'variant:peek');
          if (!window.CardSwatchesReady) updateCard(swatch, variant);
        });

        document.addEventListener('pointerout', function (event) {
          var swatch = swatchAt(event.target);
          if (!swatch) return;

          var picker = swatch.closest('variant-swatches') || swatch.closest('.swatch-picker');
          var going = event.relatedTarget;
          if (going && going.closest && going.closest('.swatch-picker') === picker) return;

          if (picker) {
            picker.dispatchEvent(
              new CustomEvent('variant:peekend', { bubbles: true, detail: { picker: picker } })
            );
          }
        });

        {%- comment -%}
          Au doigt il n'y a pas de survol : on suit le point de contact, pour que glisser le long
          de la rangée fasse défiler les coloris.
        {%- endcomment -%}
        document.addEventListener(
          'touchmove',
          function (event) {
            var touch = event.touches[0];
            if (!touch) return;

            var swatch = swatchAt(document.elementFromPoint(touch.clientX, touch.clientY));
            if (!swatch) return;

            var host = swatch.closest('variant-swatches');
            if (host && typeof host.peek === 'function' && typeof host.setup === 'function' && host.setup()) {
              host.peek(swatch);
              return;
            }

            var variant = variantOnSwatch(swatch);
            if (variant) announce(swatch, variant, 'variant:peek');
          },
          { passive: true }
        );

        {%- comment -%}
          Diagnostic embarqué, activé par `swatch-debug` dans l'URL. Le storefront est
          inaccessible depuis les environnements de développement : ce panneau lit sur place ce
          qu'on ne peut pas observer à distance — thème réellement servi, mode éditeur,
          recouvrement de la première pastille visible, trace des gestes — et l'affiche dans un
          coin, lisible et photographiable depuis n'importe quel appareil, console comprise ou
          non. `pointer-events:none` : le panneau ne peut pas devenir lui-même un calque.
        {%- endcomment -%}
        var panel = null;
        var logLines = [];

        function label(el) {
          if (!el) return 'null';
          if (el === document) return 'document';
          if (el === window) return 'window';

          var name = el.tagName || String(el);
          if (el.id) name += '#' + el.id;
          var cls = el.className;
          if (cls && cls.baseVal !== undefined) cls = cls.baseVal;
          if (cls) name += '.' + String(cls).trim().split(/\s+/).slice(0, 3).join('.');
          return name;
        }

        function debugHeader() {
          var theme = window.Shopify && window.Shopify.theme
            ? window.Shopify.theme.id + ' (' + window.Shopify.theme.role + ')'
            : 'inconnu';
          var buttons = document.querySelectorAll('.swatch-picker__swatch');

          var reach = 'aucune pastille à l’écran';
          for (var i = 0; i < buttons.length; i++) {
            var rect = buttons[i].getBoundingClientRect();
            if (rect.width === 0 || rect.bottom < 0 || rect.top > window.innerHeight) continue;
            var over = document.elementFromPoint(rect.left + rect.width / 2, rect.top + rect.height / 2);
            if (!over) continue;
            reach = buttons[i] === over || buttons[i].contains(over)
              ? 'OUI'
              : 'NON — recouverte par ' + label(over);
            break;
          }

          return 'thème servi : ' + theme
            + '\néditeur de thème : ' + (window.Shopify && window.Shopify.designMode ? 'OUI' : 'non')
            + '\npastilles : ' + buttons.length
            + '\n1re pastille visible cliquable : ' + reach
            + '\n──────────────';
        }

        function renderPanel() {
          if (!panel) return;
          panel.textContent = debugHeader() + '\n'
            + (logLines.length ? logLines.join('\n') : '(touche une pastille…)');
        }

        function debugEvent(type, event, swatch) {
          if (!panel) return;
          var how = 'non';
          if (swatch) {
            how = swatchAt(event.target)
              ? 'OUI'
              : 'OUI, par coordonnées — calque : ' + label(event.target);
          }
          logLines.push('[' + type + '] ' + label(event.target) + ' → pastille : ' + how);
          if (logLines.length > 7) logLines.shift();
          renderPanel();
        }

        if (/swatch-debug/.test(window.location.search + window.location.hash)) {
          panel = document.createElement('div');
          panel.setAttribute(
            'style',
            'position:fixed;left:8px;bottom:8px;z-index:2147483647;max-width:92vw;'
              + 'padding:10px 12px;border-radius:8px;background:rgba(15,15,15,0.88);color:#fff;'
              + 'font:11px/1.5 ui-monospace,Menlo,monospace;white-space:pre-wrap;'
              + 'overflow-wrap:anywhere;pointer-events:none;'
          );
          document.body.appendChild(panel);
          renderPanel();
          setInterval(renderPanel, 1500);
        }
      })();
    </script>

    {%- comment -%}
      Raffinement du sélecteur : table complète des variantes et prévisualisation. Le point
      d'entrée ci-dessus fonctionne sans lui.
    {%- endcomment -%}
    <script src="{{ 'variant-swatches.js' | asset_url }}" defer="defer"></script>

    <script src="{{ 'card-swatches.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'card-dots.js' | asset_url }}" defer="defer"></script>

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`,
      };

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
      };

      window.quickOrderListStrings = {
        itemsAdded: `{{ 'sections.quick_order_list.items_added.other' | t: quantity: '[quantity]' }}`,
        itemAdded: `{{ 'sections.quick_order_list.items_added.one' | t: quantity: '[quantity]' }}`,
        itemsRemoved: `{{ 'sections.quick_order_list.items_removed.other' | t: quantity: '[quantity]' }}`,
        itemRemoved: `{{ 'sections.quick_order_list.items_removed.one' | t: quantity: '[quantity]' }}`,
        viewCart: `{{- 'sections.quick_order_list.view_cart' | t -}}`,
        each: `{{- 'sections.quick_order_list.each' | t: money: '[money]' }}`,
        min_error: `{{- 'sections.quick_order_list.min_error' | t: min: '[min]' }}`,
        max_error: `{{- 'sections.quick_order_list.max_error' | t: max: '[max]' }}`,
        step_error: `{{- 'sections.quick_order_list.step_error' | t: step: '[step]' }}`,
      };

      window.accessibilityStrings = {
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        pauseSlideshow: `{{ 'sections.slideshow.pause_slideshow' | t }}`,
        playSlideshow: `{{ 'sections.slideshow.play_slideshow' | t }}`,
        recipientFormExpanded: `{{ 'recipient.form.expanded' | t }}`,
        recipientFormCollapsed: `{{ 'recipient.form.collapsed' | t }}`,
        countrySelectorSearchCount: `{{ 'localization.country_results_count' | t: count: '[count]' }}`,
      };
    </script>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const REDIRECTS = {
          '/collections/junior': { filters: { 'filter.p.m.custom.collections': 'Junior' } },
          '/collections/combi': { filters: { 'filter.p.m.custom.collections': 'Combi' } },
          '/collections/flex': { filters: { 'filter.p.m.custom.collections': 'Flex' } },
          '/collections/equo': { filters: { 'filter.p.m.custom.collections': 'Equo' } },
          '/collections/ecaille': { filters: { 'filter.p.m.custom.collections': 'Ecaille' } },
          '/collections/neo-retro': { filters: { 'filter.p.m.custom.collections': 'Neo+Retro' } },
        };

        document.querySelectorAll('a[href]').forEach((link) => {
          try {
            const url = new URL(link.href, window.location.origin);
            const path = url.pathname.replace(/\/$/, '');

            for (const key in REDIRECTS) {
              if (path.endsWith(key)) {
                const filters = REDIRECTS[key].filters;
                const langPrefixMatch = path.match(/^\/(en|it)/);
                const langPrefix = langPrefixMatch ? `/${langPrefixMatch[1]}` : '';
                const newUrl = new URL(langPrefix + '/collections/optiques', window.location.origin);

                Object.entries(filters).forEach(([k, v]) => {
                  newUrl.searchParams.set(k, v);
                });

                link.href = newUrl.toString().replace(/%2B/g, '+');
                break;
              }
            }
          } catch (e) {
            // ignore invalid URLs
          }
        });
      });
    </script>

    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.cart_type == 'drawer' -%}
      <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'overlay-reset.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </body>
</html>
