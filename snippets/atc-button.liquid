<atc-button>
  {% form 'product', product, class: 'product-purchase flex gap-4' %}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

    <div class="relative outline outline-1 outline-secondary-brown/30">
      <label for="quantity" class="u-sr-only">Quantité</label>
      <select
        name="quantity"
        id="quantity"
        class="appearance-none cursor-pointer font-form bg-transparent w-[7.4rem] h-full pl-8 u-hover-opacity"
      >
        {% for i in (1..10) %}
          <option class="font-form" value="{{ i }}">{{ i }}</option>
        {% endfor %}
      </select>
      <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-8">
        {{- 'down-chevron.svg' | inline_asset_content -}}
      </span>
    </div>

    <button
      type="submit"
      class="button full-dark full-dark--transparent {% unless product.selected_or_first_available_variant.available %}button--disabled{% endunless %}"
      {% unless product.selected_or_first_available_variant.available %}
        disabled
      {% endunless %}
    >
      {% if product.selected_or_first_available_variant.available %}
        <span>{{ 'products.product.add_to_cart' | t }}</span>
      {% else %}
        <span>{{ 'products.product.sold_out' | t }}</span>
      {% endif %}
    </button>
  {% endform %}
</atc-button>
