{% comment %}
  Renders a product card

  Accepts:
  - card_product: {Object} Product Liquid object (optional)
  - media_aspect_ratio: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
  - image_shape: {String} Image mask to apply to the product image card. Values are "arch", "blob", "chevronleft", "chevronright", "diamond", "parallelogram", and "round". (optional)
  - show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
  - show_vendor: {Boolean} Show the product vendor. Default: false
  - show_rating: {Boolean} Show the product rating. Default: false
  - extend_height: {Boolean} Card height extends to available container space. Default: true (optional)
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
  - skip_styles: {Boolean} Don't include component styles. Useful when rendering multiple product cards in a loop. Default: false (optional)
  - quick_add: {Boolean} Show the quick add button.
  - section_id: {String} The ID of the section that contains this card.
  - horizontal_class: {Boolean} Add a card--horizontal class if set to true. Default: false (optional)
  - horizontal_quick_add: {Boolean} Changes the quick add button styles when set to true. Default: false (optional)
  - placeholder_image: {String} The placeholder image to use when no product exists. Default: 'product-apparel-2' (optional)
  - card_sizes: {String} `sizes` attribute for the card images. Override it when the card is not
    laid out full-width on mobile (e.g. the 2-per-row collection grid). (optional)

  Usage:
  {% render 'card-product', show_vendor: section.settings.show_vendor %}
{% endcomment %}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign featured_media = card_product.featured_media

    if card_variant and card_variant.featured_media
      assign featured_media = card_variant.featured_media
    endif

    assign card_sizes = card_sizes | default: '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw'
  -%}

  <div class="product-card relative cursor-pointer h-[41.7rem] xl:h-[47rem] group">
    <div
      class="card bg-white py-[2.3rem] px-[1.7rem]"
    >
      <div
        class="card__inner aspect-[0.91/1] xl:aspect-[0.95/1] relative overflow-hidden cursor-grab"
      >
        {%- assign badges = '' -%}

        {%- if card_variant -%}
          {%- if card_variant.available == false -%}
            {%- assign badges = badges | append: 'sold_out|' -%}
          {%- endif -%}

          {%- if card_variant.compare_at_price > card_variant.price -%}
            {%- assign badges = badges | append: 'on_sale|' -%}
          {%- endif -%}

          {%- if card_variant.metafields.custom.new_product == true -%}
            {%- assign badges = badges | append: 'new|' -%}
          {%- endif -%}

          {%- if card_variant.metafields.custom.success_product == true -%}
            {%- assign badges = badges | append: 'success|' -%}
          {%- endif -%}

          {%- if card_variant.metafields.custom.soon_product == true -%}
            {%- assign badges = badges | append: 'soon|' -%}
          {%- endif -%}

          {%- if card_variant.metafields.custom.best_seller == true -%}
            {%- assign badges = badges | append: 'best_seller|' -%}
          {%- endif -%}

        {%- endif -%}

        {%- assign badges_array = badges | split: '|' -%}

        {%- if badges_array.size > 0 -%}
          <div class="card__badge absolute z-10 top-6 left-6 flex flex-wrap gap-2">
            {%- for badge in badges_array -%}
              {%- if badge != '' -%}
                <div class="py-2 px-[1.6rem] bg-primary-beige rounded-[10rem] font-menu text-secondary-brown w-fit">
                  {%- case badge -%}
                    {%- when 'sold_out' -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- when 'on_sale' -%}
                      {{ 'products.product.on_sale' | t }}
                    {%- when 'new' -%}
                      {{ 'products.product.new' | t }}
                    {%- when 'success' -%}
                      {{ 'products.product.success' | t }}
                    {%- when 'soon' -%}
                      {{ 'products.product.soon' | t }}
                    {%- when 'best_seller' -%}
                      {{ 'products.product.best_seller' | t }}
                  {%- endcase -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if featured_media -%}
          <div class="card__media w-full h-full relative group overflow-hidden">
            <div class="slider relative w-full h-full">
              {%- liquid
                assign main_media = null

                if card_variant and card_variant.featured_media
                  assign main_media = card_variant.featured_media
                endif

                if main_media == null and card_product.media.size > 0
                  assign main_media = card_product.media[0]
                endif
              -%}

              {%- if main_media -%}
                <div
                  class="main-media slide absolute inset-0 transition-opacity duration-300 opacity-100"
                  data-index="0"
                >
                  {% render 'image',
                    image: main_media,
                    alt: main_media.alt,
                    sizes: card_sizes,
                    image_class: 'object-cover w-full h-full pointer-events-none'
                  %}
                </div>
              {%- endif -%}

              {%- assign index = 1 -%}

              {%- if card_variant.metafields.custom.images.value != blank -%}
                {%- for media in card_variant.metafields.custom.images.value -%}
                  <div
                    class="slide absolute inset-0 transition-opacity ease-smooth duration-500 opacity-0"
                    data-index="{{ index }}"
                  >
                    {% render 'image',
                      image: media,
                      alt: media.alt,
                      sizes: card_sizes,
                      image_class: 'object-cover w-full h-full pointer-events-none'
                    %}
                  </div>

                  {%- assign index = index | plus: 1 -%}
                {%- endfor -%}
              {%- endif -%}
            </div>

            {%- comment -%}
              `index` has been incremented once per extra slide above, so it is the total slide
              count. Below 2 the arrows would be dead controls, so they are not rendered.
              Positioning and visibility live in base.css (.card__pager) rather than in utility
              classes: on touch there is no hover, so the arrows have to stay on screen.
            {%- endcomment -%}
            {%- if index > 1 -%}
              <div class="card__pager card__pager--prev">
                {% render 'pager', size: 'small', bg: 'false' %}
              </div>
              <div class="card__pager card__pager--next">
                {% render 'pager', mode: 'next', size: 'small', bg: 'false' %}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      <div class="card__content">
        <div class="card__information mt-6">
          <h3
            class="card__heading font-name-product-mobile xl:font-name-product-s"
            {% if card_product.featured_media or settings.card_style == 'card' %}
              id="title-{{ section_id }}-{{ card_product.id }}"
            {% endif %}
          >
            <a
              href="{{ card_variant.url }}"
              id="CardLink-{{ section_id }}-{{ card_product.id }}"
              class="card__link flex flex-wrap justify-between"
              aria-labelledby="CardLink-{{ section_id }}-{{ card_product.id }} Badge-{{ section_id }}-{{ card_product.id }}"
            >
              <div class="flex items-center">
                {%- assign in_cart = false -%}
                {%- for item in cart.items -%}
                  {%- if card_variant and item.variant_id == card_variant.id -%}
                    {%- assign in_cart = true -%}
                  {%- endif -%}
                {%- endfor -%}

                <span
                  class="
                    flex h-[1.6rem] transition-all duration-500 ease-smooth
                    {% if in_cart %}
                      opacity-100 w-[1.6rem] mr-4
                    {% else %}
                      w-0 opacity-0 group-hover:opacity-100 group-hover:w-[1.6rem] group-hover:mr-4
                    {% endif %}
                  "
                >
                  {{ 'icon-cart.svg' | inline_asset_content }}
                </span>
                <span>{{ card_product.title | escape }}</span>
              </div>
              {% if card_product.type == 'Solaire' %}
                {% render 'price',
                  product: card_product,
                  use_variant: true,
                  show_compare_at_price: true,
                  target_variant: card_variant
                %}
              {% endif %}
            </a>
          </h3>
          <div class="card-information">
            <div class="font-text-mentions text-[#756565] mt-4">
              {% assign montures = '' %}
              {% for variant in card_product.variants %}
                {% unless montures contains variant.option1 %}
                  {% assign montures = montures | append: variant.option1 | append: '|' %}
                {% endunless %}
              {% endfor %}
              {% assign montures_count = montures | split: '|' | uniq | compact | size %}
              {{ montures_count }} Coloris
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
