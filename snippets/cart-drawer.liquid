{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Safety net for the closed state (the authoritative rules live in base.css).
  `.drawer` on its own would also hide the drawer while it is open, because the
  `.drawer.active` rule that reveals it lives in an earlier stylesheet.
{%- endcomment -%}
<style>
  .drawer:not(.active) {
    visibility: hidden;
    pointer-events: none;
  }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      <div class="drawer__header">
        <p class="drawer__heading font-menu">{{ 'sections.cart.title' | t }}</p>
        <button class="drawer__close" type="button" onclick="this.closest('cart-drawer').close()">
          <span class="svg-wrapper !w-6 !h-6">{{- 'icon-close.svg' | inline_asset_content -}}</span>
        </button>
      </div>
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
            <div class="cart-drawer__empty-content">
              <p class="cart__empty-text">{{ 'sections.cart.empty' | t }}</p>
              <a href="{{ routes.collections_url }}/solaires" class="mt-8 button full-dark full-dark--transparent">
                <span>{{ 'general.continue_shopping' | t }}</span>
              </a>

              {%- if shop.customer_accounts_enabled and customer == null -%}
                <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
                <p class="cart__login-paragraph">
                  {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                </p>
              {%- endif -%}
            </div>
          </div>
          {%- if settings.cart_drawer_collection != blank -%}
            <div class="cart-drawer__collection">
              {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      <cart-drawer-items
        {% if cart == empty %}
          class=" is-empty"
        {% endif %}
      >
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
          novalidate
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div data-lenis-prevent class="cart-drawer__items-wrapper">
                {%- for item in cart.items -%}
                  <div class="cart-card">
                    <div class="cart-card__left">
                      {%- if item.image -%}
                        <div class="cart-card__image">
                          <img
                            src="{{ item.image | image_url: width: 300 }}"
                            alt="{{ item.image.alt | escape }}"
                            loading="lazy"
                            width="70"
                            height="{{ 70 | divided_by: item.image.aspect_ratio | ceil }}"
                          >
                        </div>
                      {%- endif -%}
                      <div class="cart-card__details">
                        {%- if settings.show_vendor -%}
                          <p class="cart-card__vendor">{{ item.product.vendor }}</p>
                        {%- endif -%}

                        <h3 class="cart-card__title">
                          <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                        </h3>

                        {%- if item.product.has_only_default_variant == false
                          or item.properties.size != 0
                          or item.selling_plan_allocation != null
                        -%}
                          <div class="cart-card__description">
                            {%- if item.product.has_only_default_variant == false -%}
                              {%- for option in item.options_with_values -%}
                                <div class="cart-card__description-option">
                                  <p>{{ option.name }}:</p>
                                  <p>
                                    {{ option.value -}}
                                    {% unless forloop.last %}, {% endunless %}
                                  </p>
                                </div>
                              {%- endfor -%}
                            {%- endif -%}

                            {%- for property in item.properties -%}
                              {%- assign property_first_char = property.first | slice: 0 -%}
                              {%- if property.last != blank and property_first_char != '_' -%}
                                <div>
                                  <dt>{{ property.first }}:</dt>
                                  <dd>
                                    {%- if property.last contains '/uploads/' -%}
                                      <a href="{{ property.last }}" target="_blank">
                                        {{- property.last | split: '/' | last -}}
                                      </a>
                                    {%- else -%}
                                      {{ property.last }}
                                    {%- endif -%}
                                  </dd>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>

                          {%- if item.selling_plan_allocation -%}
                            <p>{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}
                        {%- endif -%}

                        {%- if item.line_level_discount_allocations.size > 0 -%}
                          <ul class="cart-card__discounts">
                            {%- for discount in item.line_level_discount_allocations -%}
                              <li>{{ discount.discount_application.title }}</li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    </div>

                    <div class="cart-card__right">
                      <div class="cart-card__price">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <s>{{ item.original_line_price | money }}</s>
                        {%- endif -%}
                        <span>{{ item.final_line_price | money }}</span>
                      </div>

                      {%- if item.variant.available and item.unit_price_measurement -%}
                        {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                      {%- endif -%}

                      {%- liquid
                        assign has_qty_rules = false
                        if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                          assign has_qty_rules = true
                        endif

                        assign has_vol_pricing = false
                        if item.variant.quantity_price_breaks.size > 0
                          assign has_vol_pricing = true
                        endif
                      -%}

                      <div class="cart-card__quantity">
                        <quantity-popover>
                          <quantity-input>
                            <button
                              class="quantity__button"
                              name="minus"
                              type="button"
                              {%- if item.quantity <= 1 %}
                                disabled
                              {%- endif -%}
                            >
                              −
                            </button>
                            <input
                              type="number"
                              data-quantity-variant-id="{{ item.variant.id }}"
                              name="updates[]"
                              value="{{ item.quantity }}"
                              min="0"
                              data-min="{{ item.variant.quantity_rule.min }}"
                              {%- if item.variant.quantity_rule.max != null %}
                                max="{{ item.variant.quantity_rule.max }}"
                              {% endif %}
                              step="{{ item.variant.quantity_rule.increment }}"
                              id="Drawer-quantity-{{ item.index | plus: 1 }}"
                              data-index="{{ item.index | plus: 1 }}"
                            >
                            <button class="quantity__button" name="plus" type="button">+</button>
                          </quantity-input>

                          <cart-remove-button
                            id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                            data-index="{{ item.index | plus: 1 }}"
                          >
                            <button
                              type="button"
                              class="cart-item-card__remove"
                              aria-label="Supprimer {{ item.product.title }}"
                              data-variant-id="{{ item.variant.id }}"
                              {%- if item.instructions and item.instructions.can_remove == false %}
                                style="display: none;"
                              {% endif %}
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-remove.svg' | inline_asset_content -}}
                              </span>
                            </button>
                          </cart-remove-button>

                          {%- if has_qty_rules or has_vol_pricing -%}
                            <button type="button" class="cart-card__info-btn">ℹ</button>

                            <div class="cart-card__popup" hidden>
                              {%- if has_qty_rules -%}
                                <div>
                                  {%- if item.variant.quantity_rule.increment > 1 -%}
                                    <span>
                                      {{-
                                        'products.product.quantity.multiples_of'
                                        | t: quantity: item.variant.quantity_rule.increment
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.min > 1 -%}
                                    <span>
                                      {{-
                                        'products.product.quantity.min_of'
                                        | t: quantity: item.variant.quantity_rule.min
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.max != null -%}
                                    <span>
                                      {{-
                                        'products.product.quantity.max_of'
                                        | t: quantity: item.variant.quantity_rule.max
                                      -}}
                                    </span>
                                  {%- endif -%}
                                </div>
                              {%- endif -%}

                              {%- if has_vol_pricing -%}
                                <div>
                                  <span>{{ 'products.product.volume_pricing.title' | t }}</span>
                                  <ul>
                                    <li>
                                      <span>{{ item.variant.quantity_rule.min }}+</span>
                                      <span>{{ item.variant.price | money_with_currency }}/ea</span>
                                    </li>
                                    {%- for price_break in item.variant.quantity_price_breaks -%}
                                      <li>
                                        <span>{{ price_break.minimum_quantity }}+</span>
                                        <span>{{ price_break.price | money_with_currency }}/ea</span>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                </div>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                        </quantity-popover>
                      </div>
                    </div>
                  </div>
                  <div
                    id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}"
                    class="cart-card__error"
                    role="alert"
                  >
                    <small class="cart-item__error-text"></small>
                  </div>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="cart-drawer__empty">
                <p>Votre panier est vide</p>
              </div>
            {%- endif -%}
            {%- if settings.show_cart_note -%}
              <details id="Details-CartDrawer">
                <summary>
                  <span class="summary__title">
                    {{ 'sections.cart.note' | t }}
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </summary>
                <cart-note class="cart__note field">
                  <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart.note' | t }}</label>
                  <textarea
                    id="CartDrawer-Note"
                    class="text-area text-area--resize-vertical field__input"
                    name="note"
                    placeholder="{{ 'sections.cart.note' | t }}"
                  >{{ cart.note }}</textarea>
                </cart-note>
              </details>
            {%- endif -%}

            <div class="cart-drawer__footer" {{ block.shopify_attributes }}>
              <div>
                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                    {%- for discount in cart.cart_level_discount_applications -%}
                      <li class="discounts__discount discounts__discount--end">
                        {{- 'icon-discount.svg' | inline_asset_content -}}
                        {{ discount.title | escape }}
                        (-{{ discount.total_allocated_amount | money }})
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>

              <div class="totals" role="status">
                <h2 class="totals__total">{{ 'sections.cart.estimated_total' | t }}</h2>
                <div class="totals__total-wrapper">
                  <p class="totals__total-value">{{ cart.total_price | money_with_currency }}</p>
                  <small class="tax-note caption-large rte cart-totals-text">
                    {%- if cart.duties_included and cart.taxes_included -%}
                      {%- if shop.shipping_policy.body == blank -%}
                        {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
                      {%- else -%}
                        {{
                          'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                          | t: link: shop.shipping_policy.url
                        }}
                      {%- endif -%}
                    {%- elsif cart.duties_included == false and cart.taxes_included -%}
                      {%- if shop.shipping_policy.body == blank -%}
                        {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
                      {%- else -%}
                        {{
                          'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                          | t: link: shop.shipping_policy.url
                        }}
                      {%- endif -%}
                    {%- elsif cart.duties_included and cart.taxes_included == false -%}
                      {%- if shop.shipping_policy.body == blank -%}
                        {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                      {%- else -%}
                        {{
                          'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                          | t: link: shop.shipping_policy.url
                        }}
                      {%- endif -%}
                    {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
                      {%- if shop.shipping_policy.body == blank -%}
                        {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                      {%- else -%}
                        {{
                          'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                          | t: link: shop.shipping_policy.url
                        }}
                      {%- endif -%}
                    {%- endif -%}
                  </small>
                  {%- if settings.cart_totals_text != blank -%}
                    <div class="cart-totals-text rte mt-4">{{ settings.cart_totals_text }}</div>
                  {%- endif -%}
                </div>
              </div>
            </div>
            {%- if cart != empty -%}
              <div class="cart-cgv w-full mt-4">
                <div class="flex items-center gap-2 ml-auto w-fit">
                  <input
                    type="checkbox"
                    id="CartDrawer-CGV"
                    name="attributes[CGV acceptées]"
                    value="Oui"
                    form="CartDrawer-Form"
                    class="w-4 h-4 cursor-pointer"
                  >
                  <input
                    type="hidden"
                    id="CartDrawer-CGV-Timestamp"
                    name="attributes[CGV - Date d'acceptation]"
                    value=""
                    form="CartDrawer-Form"
                  >
                  <label for="CartDrawer-CGV" class="cursor-pointer">
                    {{ 'sections.cart.cgv_agree' | t }}
                    <a href="{{ 'sections.cart.cgv_link_url' | t }}" target="_blank" class="underline">
                      {{ 'sections.cart.cgv_link_text' | t }}
                    </a>
                  </label>
                </div>
              </div>
            {%- endif -%}

            <div class="cart__ctas w-fit mx-auto mt-8 xl:mr-0" {{ block.shopify_attributes }}>
              <button
                type="submit"
                id="CartDrawer-Checkout"
                class="cart__checkout-button button full-dark full-dark--transparent "
                name="checkout"
                form="CartDrawer-Form"
                disabled
              >
                <span>{{ 'sections.cart.checkout' | t }}</span>
              </button>
            </div>

            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
        </form>
      </cart-drawer-items>
      <div class="drawer__column hidden xl:block">
        {%- assign has_columns = false -%}
        {%- for i in (1..4) -%}
          {%- assign image_key = 'cart_column_' | append: i | append: '_image' -%}
          {%- assign title_key = 'cart_column_' | append: i | append: '_title' -%}
          {%- if settings[image_key] != blank or settings[title_key] != blank -%}
            {%- assign has_columns = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_columns -%}
          <div class="grid grid-cols-4 gap-4">
            {%- for i in (1..4) -%}
              {%- assign image_key = 'cart_column_' | append: i | append: '_image' -%}
              {%- assign title_key = 'cart_column_' | append: i | append: '_title' -%}
              {%- assign col_image = settings[image_key] -%}
              {%- assign col_title = settings[title_key] -%}
              {%- if col_image != blank or col_title != blank -%}
                <div class="col-span-1 flex flex-col items-center gap-y-[1.5rem] p-[2.4rem] border-t border-b border-solid border-secondary-brown/30">
                  {%- if col_image != blank -%}
                    {% render 'image',
                      image: col_image,
                      alt: col_title,
                      sizes: '(max-width: 990px) 100vw, 25vw',
                      wrapper_class: 'max-w-[5rem] max-h-[3rem]',
                      image_class: 'object-contain w-full h-full'
                    %}
                  {%- endif -%}
                  {%- if col_title != blank -%}
                    <span class="font-suptitle uppercase text-center">{{ col_title }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
<script>
  function initCGVCheckbox() {
    var checkbox  = document.getElementById('CartDrawer-CGV');
    var btn       = document.getElementById('CartDrawer-Checkout');
    var timestamp = document.getElementById('CartDrawer-CGV-Timestamp');

    if (!checkbox || !btn) return;
    if (checkbox.dataset.cgvInit === 'true') return;

    btn.disabled = true;
    checkbox.dataset.cgvInit = 'true';

    checkbox.addEventListener('change', function () {
      btn.disabled = !this.checked;
      if (timestamp) {
        timestamp.value = this.checked
          ? new Date().toLocaleString('fr-FR')
          : '';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initCGVCheckbox);
  document.documentElement.addEventListener('cart:rerender', function () {
    setTimeout(initCGVCheckbox, 50);
  });
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof subscribe !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined') {
      subscribe(PUB_SUB_EVENTS.cartUpdate, function () {
        setTimeout(initCGVCheckbox, 100);
      });
    }

    setTimeout(function() {
      if (typeof CartItems !== 'undefined') {
        CartItems.prototype.setValidity = function(event, index, message) {
          event.target.setCustomValidity('');
          this.resetQuantityInput(index);
        };
      }
    }, 500);
  });
</script>
</cart-drawer>
