  {
    "name": "Panier - Témoignages",
    "settings": [
      {
        "type": "paragraph",
        "content": "Affichés en bandeau défilant sous le titre du tiroir panier. Laissez le témoignage vide pour masquer une entrée. Pensez à les remplacer par des avis réellement publiés sur votre boutique."
      },
      {
        "type": "checkbox",
        "id": "cart_testimonials_enabled",
        "label": "Afficher les témoignages dans le panier",
        "default": true
      },
