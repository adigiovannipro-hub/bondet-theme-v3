{%- style -%}
  .section-multicolumn-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}rem;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}rem;
  }

  @media screen and (min-width: 1024px) {
    .section-multicolumn-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}rem;
      padding-bottom: {{ section.settings.padding_bottom }}rem;
    }
  }
{%- endstyle -%}

<div class="u-container section-multicolumn-{{ section.id }}-padding">
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-[2rem]">
    {% for block in section.blocks %}
      <div class="flex flex-col items-center gap-y-[1.5rem] p-[2.4rem]{% if section.settings.border_top %} border-t{% endif %}{% if section.settings.border_bottom %} border-b{% endif %} border-solid border-secondary-brown/30">
        {% if block.settings.image != blank %}
          {% render 'image',
            image: block.settings.image,
            alt: block.settings.title,
            sizes: '(max-width: 990px) 100vw, 25vw',
            wrapper_class: 'max-w-[5rem] max-h-[3rem]',
            image_class: 'object-contain w-full h-full'
          %}
        {% endif %}
        {% if block.settings.title != blank %}
          <span class="font-suptitle uppercase text-center">{{ block.settings.title }}</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Multicolonne",
  "class": "section section-multicolumn",
  "tag": "section",
  "enabled_on": {
    "templates": ["index", "page", "product", "collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Espacement (1rem pour 10px)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "rem",
      "label": "Espacement en haut",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "rem",
      "label": "Espacement en bas",
      "default": 0
    },
    {
      "type": "header",
      "content": "Bordure"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Afficher la bordure en haut",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "Afficher la bordure en bas",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Colonne",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Titre",
          "label": "Titre"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolonne",
      "category": "Contenu",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
