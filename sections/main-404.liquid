<div class="template-404 relative overflow-clip mb-36">
  {% if section.settings.image %}
    <div class="absolute -inset-[4rem] blur-md">
      {% render 'image',
        image: section.settings.image,
        alt: section.settings.image.alt,
        image_class: 'object-cover w-full h-full'
      %}
    </div>
  {% endif %}
  <div class="u-container relative">
    <div class="u-grid">
      <div class="col-span-12 lg:col-span-8 lg:col-start-3">
        <div class="h-screen grid place-items-center ">
          <div class="w-full flex flex-col items-center text-center gap-[2.2rem]">
            <div class="w-fit mb-[6.6rem]">
              {% render 'separator', is_light: true, is_big: true %}
            </div>
            {% if section.settings.title %}
              <div class="flex flex-col items-center text-center gap-y-14 font-text-l-mobile lg:font-text-l text-primary-beige">
                {% render 'title', data: section.settings %}
              </div>
            {% endif %}

            {% if section.settings.show_button %}
              {% assign button_url = section.settings.button_link | default: routes.root_url %}

              {% render 'button',
                title: section.settings.button_label,
                url: button_url,
                is_link: true,
                new_tab: false,
                class: 'transparent light reverse'
              %}
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page 404",
  "tag": "section",
  "class": "section section-404",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "suptitle",
      "label": "Sur-titre",
      "default": "404"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Titre",
      "default": "Nos montures sont 100 % françaises. Cette page, en revanche, semble avoir pris la fuite..."
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Afficher le bouton",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "page d’accueil du site"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton (optionnel)"
    }
  ]
}
{% endschema %}
