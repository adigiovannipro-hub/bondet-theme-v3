<div class="pt-[5.5rem] pb-[12.5rem] bg-primary-beige">
  <div class="u-container">
    <div class="w-fit mx-auto mb-[9.3rem]">
      {% render 'separator' %}
    </div>
    <div class="u-grid">
      <div class="right-content-image__image col-span-12 md:col-span-7 lg:col-span-5 lg:col-start-3">
        <div class="wrapper">
          {% if section.settings.image %}
            {% render 'image',
              image: section.settings.image,
              alt: section.settings.image.alt,
              sizes: '(max-width: 990px) 100vw, 50vw',
              image_class: 'object-cover w-full h-full'
            %}
          {% endif %}
        </div>
      </div>
      <div class="col-span-12 md:col-span-5 lg:col-span-4">
        {% if section.settings.title != blank or section.settings.text != blank %}
          <div class="flex flex-col gap-y-14 pt-24 md:pt-0 xl:pl-8 xl:pr-[7.5rem]">
            {% if section.settings.title %}
              {% render 'title', data: section.settings %}
            {% endif %}
            {% if section.settings.text %}
              <p class="font-text-s">{{ section.settings.text | newline_to_br }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Right Content Image",
  "tag": "section",
  "class": "section section-right-content-image",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Titre"
    },
    {
      "type": "select",
      "id": "hn",
      "label": "Heading level",
      "options": [
        { "value": "1", "label": "H1" },
        { "value": "2", "label": "H2" },
        { "value": "3", "label": "H3" }
      ],
      "default": "2"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Contenu à droite et image",
      "category": "Contenu"
    }
  ]
}
{% endschema %}
